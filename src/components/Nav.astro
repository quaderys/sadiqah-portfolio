---
const base = import.meta.env.BASE_URL;

const links = [
  { label: 'About', href: '#about' },
  { label: 'Experience', href: '#experience' },
  { label: 'Projects', href: '#projects' },
  { label: 'Skills', href: '#skills' },
  { label: 'Contact', href: '#contact' },
];
---

<nav class="nav" id="nav">
  <div class="nav-inner">
    <a href={base} class="nav-logo" aria-label="Home — Sadiqah Quadery">
      <svg class="emblem" viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <!-- Outer solid circle border -->
        <circle cx="50" cy="50" r="46" stroke="white" stroke-width="1.2" opacity="0.9"/>
        <!-- Inner decorative ring -->
        <circle cx="50" cy="50" r="41" stroke="white" stroke-width="0.4" opacity="0.35"/>

        <!-- Wreath leaves — left side, fanning upward from bottom -->
        <ellipse cx="16" cy="68" rx="5.5" ry="2"   transform="rotate(-40 16 68)"  stroke="white" stroke-width="0.85" opacity="0.75"/>
        <ellipse cx="11" cy="59" rx="5.5" ry="2"   transform="rotate(-57 11 59)"  stroke="white" stroke-width="0.85" opacity="0.75"/>
        <ellipse cx="9"  cy="49" rx="5.5" ry="2"   transform="rotate(-75 9 49)"   stroke="white" stroke-width="0.85" opacity="0.75"/>
        <ellipse cx="10" cy="39" rx="5.5" ry="2"   transform="rotate(-93 10 39)"  stroke="white" stroke-width="0.85" opacity="0.75"/>
        <ellipse cx="15" cy="30" rx="5.5" ry="2"   transform="rotate(-111 15 30)" stroke="white" stroke-width="0.85" opacity="0.75"/>
        <ellipse cx="22" cy="22" rx="5.5" ry="2"   transform="rotate(-129 22 22)" stroke="white" stroke-width="0.85" opacity="0.75"/>
        <ellipse cx="32" cy="15" rx="5.5" ry="2"   transform="rotate(-147 32 15)" stroke="white" stroke-width="0.85" opacity="0.75"/>

        <!-- Wreath leaves — right side, mirrored -->
        <ellipse cx="84" cy="68" rx="5.5" ry="2"   transform="rotate(40 84 68)"   stroke="white" stroke-width="0.85" opacity="0.75"/>
        <ellipse cx="89" cy="59" rx="5.5" ry="2"   transform="rotate(57 89 59)"   stroke="white" stroke-width="0.85" opacity="0.75"/>
        <ellipse cx="91" cy="49" rx="5.5" ry="2"   transform="rotate(75 91 49)"   stroke="white" stroke-width="0.85" opacity="0.75"/>
        <ellipse cx="90" cy="39" rx="5.5" ry="2"   transform="rotate(93 90 39)"   stroke="white" stroke-width="0.85" opacity="0.75"/>
        <ellipse cx="85" cy="30" rx="5.5" ry="2"   transform="rotate(111 85 30)"  stroke="white" stroke-width="0.85" opacity="0.75"/>
        <ellipse cx="78" cy="22" rx="5.5" ry="2"   transform="rotate(129 78 22)"  stroke="white" stroke-width="0.85" opacity="0.75"/>
        <ellipse cx="68" cy="15" rx="5.5" ry="2"   transform="rotate(147 68 15)"  stroke="white" stroke-width="0.85" opacity="0.75"/>

        <!-- Bottom bow / ribbon -->
        <path d="M37 80 Q50 87 63 80"  stroke="white" stroke-width="0.9" opacity="0.65"/>
        <path d="M37 80 Q31 86 35 89"  stroke="white" stroke-width="0.75" opacity="0.55"/>
        <path d="M63 80 Q69 86 65 89"  stroke="white" stroke-width="0.75" opacity="0.55"/>
        <circle cx="50" cy="83" r="1.3" fill="white" opacity="0.55"/>

        <!-- Small top ornament -->
        <path d="M44 8 Q50 5 56 8" stroke="white" stroke-width="0.75" opacity="0.5"/>

        <!-- SQ monogram centered -->
        <text
          x="50" y="58"
          text-anchor="middle"
          font-family="Cormorant Garamond, Georgia, serif"
          font-size="23"
          font-weight="400"
          letter-spacing="4"
          fill="white"
        >SQ</text>
      </svg>
    </a>

    <ul class="nav-links">
      {links.map((l) => (
        <li><a href={l.href} class="nav-link">{l.label}</a></li>
      ))}
    </ul>

    <a href="mailto:sq227@cornell.edu" class="nav-cta">Get in Touch</a>
  </div>
</nav>

<style>
  .nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    padding: 0 2.5rem;
    border-bottom: 1px solid transparent;
    transition: border-color 0.3s, background 0.3s, box-shadow 0.3s;
  }

  .nav.scrolled {
    background: rgba(11, 29, 58, 0.96);
    backdrop-filter: blur(16px);
    border-color: var(--color-border);
    box-shadow: 0 1px 30px rgba(0, 0, 0, 0.3);
  }

  .nav-inner {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 80px;
  }

  .nav-logo {
    display: flex;
    align-items: center;
    color: white;
    transition: opacity 0.25s;
  }

  .nav-logo:hover {
    opacity: 0.75;
  }

  .emblem {
    width: 62px;
    height: 62px;
  }

  .nav-links {
    display: flex;
    gap: 2.5rem;
  }

  .nav-link {
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    transition: color 0.2s;
  }

  .nav-link:hover {
    color: var(--color-text);
  }

  .nav-cta {
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    border: 1px solid var(--color-accent);
    padding: 0.5rem 1.25rem;
    color: var(--color-accent);
    transition: background 0.2s, color 0.2s;
  }

  .nav-cta:hover {
    background: var(--color-accent);
    color: var(--color-bg);
  }

  @media (max-width: 768px) {
    .nav { padding: 0 1.5rem; }
    .nav-links { display: none; }
    .nav-cta { display: none; }
  }
</style>

<script>
  const nav = document.getElementById('nav');
  window.addEventListener('scroll', () => {
    nav?.classList.toggle('scrolled', window.scrollY > 40);
  });
</script>
